# Leaderboard backend (Vercel serverless /api/runs).
# DATABASE_URL is injected automatically by Vercel's Neon Postgres integration
# once you attach a Neon store to the project — you do NOT set it by hand.
# Listed here only so the requirement is documented.
DATABASE_URL=

# Optional: overrides the submission-signing salt. Must match SIGN_SALT in
# src/leaderboard.js if you change it. Leave unset to use the built-in default.
# CFB_SIGN_SALT=
